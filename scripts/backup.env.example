# configuration of scripts/backup.sh and scripts/restore.sh: copy it to /etc/social-backup.env
# and make it readable by root only (chmod 600). Any restic environment variable works here
# (AWS_ACCESS_KEY_ID, B2_ACCOUNT_ID, RESTIC_CACHE_DIR, ...).

# where the snapshots go: a local path, sftp:user@host:/path, s3:..., b2:..., rclone:...
RESTIC_REPOSITORY=sftp:backup@backup.example.com:/srv/restic/social
# file holding the repository password. Keep a copy somewhere else: without it the backups
# can't be read
RESTIC_PASSWORD_FILE=/etc/social-backup.password

# directory holding docker-compose.yaml (default: the repository the script is in)
#COMPOSE_DIR=/opt/social

# snapshots kept by `restic forget`
#KEEP_DAILY=7
#KEEP_WEEKLY=4
#KEEP_MONTHLY=12

# share of the repository data read back by `restic check` after every backup
#CHECK_SUBSET=2%

# optional: pinged after every successful backup, and with /fail appended when one fails
#HEALTHCHECK_URL=https://hc-ping.com/your-uuid

# --- bucket mode (assets in S3 / Cloudflare R2) ---
# With S3_BUCKET set, the backup syncs the bucket into MIRROR_DIR with rclone (which must be
# installed: apt install rclone, or https://rclone.org/install/) and backs up that mirror instead
# of the avatars/uploads/dm-uploads volumes. Without it the volumes are backed up.
#S3_BUCKET=giorgiovola-assets
# local copy of the bucket, kept between runs so only changes are downloaded (default shown)
#MIRROR_DIR=/var/lib/social-backup/assets

# rclone reads its remotes from RCLONE_CONFIG_<NAME>_* variables, so no rclone.conf is needed.
# The backup reads the bucket through the remote named in S3_REMOTE (default r2, so the variables
# start with RCLONE_CONFIG_R2_). Use a READ-ONLY token here, so a compromised backup host can't
# change or delete the assets. In the Cloudflare dashboard: R2 -> Manage API tokens -> Create
# API token, permission "Object Read only", "Apply to specific buckets only" with just this
# bucket. The token's Access Key ID and Secret Access Key go below; the endpoint is shown on the
# same page (https://<account id>.r2.cloudflarestorage.com).
#S3_REMOTE=r2
#RCLONE_CONFIG_R2_TYPE=s3
#RCLONE_CONFIG_R2_PROVIDER=Cloudflare
#RCLONE_CONFIG_R2_ENDPOINT=https://<account id>.r2.cloudflarestorage.com
#RCLONE_CONFIG_R2_REGION=auto
#RCLONE_CONFIG_R2_ACCESS_KEY_ID=
#RCLONE_CONFIG_R2_SECRET_ACCESS_KEY=
# a token scoped to one bucket can't create or check buckets
#RCLONE_CONFIG_R2_NO_CHECK_BUCKET=true

# scripts/restore.sh writes the bucket back with a second token that has "Object Read & Write"
# on the bucket (the app's token works). It is only needed when restoring, so leave it out of
# this file: restore.sh asks for the key pair, or takes RESTORE_ACCESS_KEY_ID and
# RESTORE_SECRET_ACCESS_KEY from the environment, and otherwise reuses the settings above.
# To define the restore remote in full instead, set RCLONE_CONFIG_<RESTORE_REMOTE>_* (the
# remote is named r2restore by default):
#RESTORE_REMOTE=r2restore
#RCLONE_CONFIG_R2RESTORE_TYPE=s3
#RCLONE_CONFIG_R2RESTORE_PROVIDER=Cloudflare
#RCLONE_CONFIG_R2RESTORE_ENDPOINT=https://<account id>.r2.cloudflarestorage.com
#RCLONE_CONFIG_R2RESTORE_ACCESS_KEY_ID=
#RCLONE_CONFIG_R2RESTORE_SECRET_ACCESS_KEY=
