# config of scripts/deploy.sh (installed as /usr/local/bin/social-deploy), read from
# /etc/social-deploy.env. Readable by the deploy user only: chown root:deploy, chmod 640.
# See "deploying" in README.md.

# the image the workflow pushes, lowercase: ghcr.io/<owner>/<repository>
IMAGE_REPO=ghcr.io/toastenergy/social.giorgiovola.casa
# the checkouts docker compose runs from, one per environment
PRODUCTION_DIR=/opt/social
STAGING_DIR=/opt/social-staging
# database dumps taken before every production deploy, kept in $PRODUCTION_DIR/predeploy-dumps
KEEP_DUMPS=5

# staging: fill an empty database with the test accounts of scripts/seed.ts (1) or not (0)
STAGING_SEED=1
# password of every seeded account (dev is an admin): required, the staging site is public
SEED_PASSWORD=
# optional: a fixed token for dev_bot (sgc_ + 43 characters), random when empty
SEED_BOT_TOKEN=

# blue-green: caddy proxies to whichever colour is live. Each file holds the `to` line of the
# reverse_proxy block of its site (README: deploying) and must be writable by the deploy user
PRODUCTION_UPSTREAM_FILE=/etc/caddy/social/production.upstream
STAGING_UPSTREAM_FILE=/etc/caddy/social/staging.upstream
# how caddy picks up the new upstream; reload is graceful, requests in flight finish.
# Caddy in docker: docker exec caddy caddy reload --config /etc/caddy/Caddyfile
CADDY_RELOAD="caddy reload --config /etc/caddy/Caddyfile"
# optional: the host caddy reaches the app on, when it isn't 127.0.0.1 (e.g. caddy in docker)
UPSTREAM_HOST=
# seconds the old colour keeps running after the switch, for requests already sent to it
DRAIN_SECONDS=5
