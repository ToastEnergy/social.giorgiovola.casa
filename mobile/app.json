{
	"expo": {
		"name": "Social Giorgiovola Casa",
		"slug": "social-giorgiovola",
		"version": "1.0.0",
		"orientation": "portrait",
		"icon": "./assets/icon.png",
		"userInterfaceStyle": "dark",
		"ios": {
			"supportsTablet": true,
			"bundleIdentifier": "casa.giorgiovola.social",
			"infoPlist": {
				"CFBundleDisplayName": "SGC"
			},
			"appleTeamId": "A7DPA4RJ43",
			"associatedDomains": [
				"webcredentials:social.giorgiovola.casa",
				"applinks:social.giorgiovola.casa"
			]
		},
		"android": {
			"adaptiveIcon": {
				"backgroundColor": "#ffe9e9",
				"foregroundImage": "./assets/android-icon-foreground.png",
				"monochromeImage": "./assets/android-icon-monochrome.png"
			},
			"predictiveBackGestureEnabled": false,
			"permissions": ["android.permission.REQUEST_INSTALL_PACKAGES"],
			"package": "casa.giorgiovola.social",
			"intentFilters": [
				{
					"action": "VIEW",
					"autoVerify": true,
					"data": [
						{
							"scheme": "https",
							"host": "social.giorgiovola.casa",
							"pathPrefix": "/register"
						}
					],
					"category": ["BROWSABLE", "DEFAULT"]
				}
			]
		},
		"plugins": [
			"expo-router",
			"expo-secure-store",
			"expo-image",
			"expo-video",
			"expo-font",
			"expo-web-browser",
			[
				"expo-image-picker",
				{
					"photosPermission": "Choose images for your posts, messages and profile picture."
				}
			],
			[
				"expo-media-library",
				{
					"photosPermission": "Choose images for your posts, messages and profile picture.",
					"savePhotosPermission": "Save images from posts and messages to your photos.",
					"granularPermissions": ["photo"]
				}
			],
			[
				"expo-notifications",
				{
					"icon": "./assets/notification-icon.png",
					"color": "#799a74",
					"enableRemoteNotifications": false
				}
			],
			"./plugins/disable-script-sandboxing",
			"./plugins/android-release-signing",
			["./plugins/android-launcher-label", "SGC"],
			"expo-status-bar",
			[
				"expo-splash-screen",
				{
					"image": "./assets/splash-icon.png",
					"imageWidth": 170,
					"backgroundColor": "#0c0b0b"
				}
			]
		],
		"scheme": "sgc-app",
		"extra": {
			"updateRepo": "ToastEnergy/social.giorgiovola.casa"
		},
		"backgroundColor": "#0c0b0b"
	}
}
