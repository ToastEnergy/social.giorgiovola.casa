# port the app listens on (host and container)
PORT=7777
# public URL of your instance, used for links, social cards and CSRF checks.
# The CSRF origin is compiled in at build time, so rebuild after changing it
PUBLIC_URL=http://localhost:7777
# placeholder text of the search box (default: Giorgiocerca qualcosa)
PUBLIC_SEARCH_PLACEHOLDER=
# placeholder of the reply bar on an open post, on touch devices (default: Giorgia un commento)
PUBLIC_REPLY_PLACEHOLDER=
# shown under an open post with no replies yet (default: Nessuno ha ancora giorgiato qui)
PUBLIC_NO_REPLIES_MESSAGE=
# optional: new posts are announced to this Discord webhook
DISCORD_WEBHOOK_URL=
# postgres password and (dev compose only) the host port the database is published on.
# The password is only applied when the database volume is first created, and must be URL-safe
# (it is embedded in DATABASE_URL). If you change them, update DATABASE_URL to match
POSTGRES_PASSWORD=postgres
POSTGRES_PORT=5432
# postgres connection string for running the app outside docker (e.g. bun run dev with docker-compose.dev.yaml).
# docker-compose.yaml builds its own, so this is ignored there
DATABASE_URL=postgres://postgres:postgres@localhost:5432/postgres
# password people need to enter to register; registration is closed while this is empty
SIGNUP_PASSWORD=
# header holding the real client IP when behind a proxy, enables per-IP rate limits
# (e.g. CF-Connecting-IP behind Cloudflare, X-Forwarded-For behind caddy/nginx)
ADDRESS_HEADER=
# interface the port is published on; 0.0.0.0 exposes it to the network
BIND_ADDRESS=127.0.0.1
# optional: keep avatars and uploaded images in an S3-compatible bucket (Cloudflare R2) instead of
# static/avatars and static/uploads. S3_BUCKET needs the endpoint and both keys; the region
# defaults to auto (R2). See "storing assets in S3 / R2" in the README
S3_BUCKET=
S3_ENDPOINT=
S3_REGION=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# who downloads the pages of links in posts to show their preview: local (this server, default),
# remote (the Cloudflare Worker in workers/link-preview) or off. local shows the server's IP address
# to every linked site: use remote if the server is hidden behind Cloudflare. See "link previews"
# in the README
LINK_PREVIEWS=
# with LINK_PREVIEWS=remote: the worker's URL and the secret set on it with wrangler secret put
LINK_PREVIEWS_URL=
LINK_PREVIEWS_SECRET=
# GIFs from KLIPY: the app key from https://partner.klipy.com (empty turns GIFs off). It is public:
# browsers search KLIPY with it. See "GIFs" in the README
KLIPY_APP_KEY=
# KLIPY's content safety level for searches: off, low, medium (default) or high
KLIPY_CONTENT_FILTER=
# only for scripts/migrate-assets.ts --purge (purging old image URLs from Cloudflare), not read by
# the app. The token needs the Zone > Cache Purge permission. docker compose doesn't pass these to
# the container: docker compose exec -e CLOUDFLARE_ZONE_ID=… -e CLOUDFLARE_API_TOKEN=… web bun …
CLOUDFLARE_ZONE_ID=
CLOUDFLARE_API_TOKEN=
